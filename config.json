{
  "project": {
    "name": "full-api",
    "module": "github.com/example/full-api"
  },
  "framework": {
    "provider": "gin"
  },
  "api": {
    "protocol": "rest",
    "serialization": "json"
  },
  "database": {
    "provider": "postgresql",
    "orm": "gorm"
  },
  "cache": {
    "provider": "redis"
  }
}